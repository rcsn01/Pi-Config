{
	"name": "pi-config",
	"private": true,
	"type": "module",
	"dependencies": {
		"@anthropic-ai/sandbox-runtime": "0.0.73",
		"@mozilla/readability": "^0.5.0",
		"linkedom": "^0.16.0",
		"turndown": "^7.2.0",
		"unpdf": "^1.4.0"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "0.84.1",
		"@earendil-works/pi-coding-agent": "0.84.1",
		"@earendil-works/pi-tui": "0.84.1",
		"@types/node": "26.1.2",
		"@types/turndown": "5.0.6",
		"ignore": "7.0.5",
		"typebox": "1.3.11",
		"typescript": "7.0.2",
		"vitest": "4.1.10"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "pnpm test:core && pnpm test:features && pnpm test:analysis && pnpm test:cache-effort && pnpm test:profiles && pnpm test:subscription-usage && pnpm test:safety && pnpm test:ask-user && pnpm test:advisor && pnpm test:subagents && pnpm test:todos && pnpm test:web-fetch && pnpm test:github-repos && pnpm test:status && pnpm test:steer && pnpm test:goal && pnpm test:plan && pnpm test:workflows && pnpm test:integrations",
		"test:core": "vitest run extensions/_shared extensions/auto-compact",
		"test:analysis": "vitest run extensions/observability-analysis",
		"test:cache-effort": "vitest run extensions/diagnostics-cache-effort",
		"test:safety": "vitest run extensions/safety-permissions",
		"test:ask-user": "vitest run extensions/tools-ask-user",
		"test:advisor": "vitest run extensions/tools-advisor",
		"test:subagents": "vitest run extensions/tools-subagents",
		"test:subscription-usage": "vitest run extensions/subscription-usage",
		"test:features": "vitest run extensions/system-feature-flags/catalog.test.ts extensions/ui-model-selector/model-config.test.ts extensions/ui-context/context-model.test.ts extensions/ui-context/global-usage.test.ts extensions/ui-context/global-usage-render.test.ts extensions/ui-context/usage-tables.test.ts",
		"test:profiles": "vitest run extensions/config-profiles",
		"test:todos": "vitest run extensions/tools-todo",
		"test:web-fetch": "vitest run extensions/tools-web-fetch extensions/tools-web-search",
		"test:github-repos": "vitest run extensions/tools-github-repos",
		"test:goal": "vitest run extensions/workflows-goal",
		"test:plan": "vitest run extensions/workflows-plan-mode",
		"test:workflows": "pnpm exec vitest run extensions/workflows-runtime/index.test.ts && node --test extensions/workflows-runtime/tests/*.test.mjs",
		"test:integrations": "vitest run extensions-disabled/integration-plane/lib/plane/client.test.ts",
		"test:status": "vitest run extensions/ui-status-separators",
		"test:steer": "vitest run extensions/ui-steer-input"
	}
}
