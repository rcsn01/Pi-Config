{
	"name": "pi-config",
	"private": true,
	"type": "module",
	"dependencies": {
		"@anthropic-ai/sandbox-runtime": "0.0.73",
		"@mozilla/readability": "^0.5.0",
		"linkedom": "^0.16.0",
		"turndown": "^7.2.0",
		"unpdf": "^1.4.0"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "0.84.1",
		"@earendil-works/pi-coding-agent": "0.84.1",
		"@earendil-works/pi-tui": "0.84.1",
		"@types/node": "26.1.2",
		"@types/turndown": "5.0.6",
		"ignore": "7.0.5",
		"typebox": "1.3.11",
		"typescript": "7.0.2",
		"vitest": "4.1.10"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "pnpm test:core && pnpm test:features && pnpm test:safety && pnpm test:todos && pnpm test:web-fetch && pnpm test:plan && pnpm test:workflows && pnpm test:integrations",
		"test:core": "vitest run extensions/_shared",
		"test:safety": "vitest run extensions/safety-permissions",		"test:features": "vitest run extensions/system-feature-flags/catalog.test.ts extensions/ui-model-selector/model-config.test.ts extensions/ui-context/context-model.test.ts",
		"test:todos": "vitest run extensions/tools-todo/todo-state.test.ts extensions/tools-todo/todo-prompt.test.ts",
		"test:web-fetch": "vitest run extensions/tools-web-fetch",
		"test:plan": "vitest run extensions/workflows-plan-mode",
		"test:workflows": "node --test extensions/workflows-runtime/tests/*.test.mjs",
		"test:integrations": "vitest run extensions-disabled/integration-plane/lib/plane/client.test.ts"
	}
}
