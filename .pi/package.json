{
	"name": "pi-config",
	"private": true,
	"type": "module",
	"dependencies": {
		"@anthropic-ai/sandbox-runtime": "0.0.73",
		"@mozilla/readability": "^0.5.0",
		"linkedom": "^0.16.0",
		"proper-lockfile": "4.1.2",
		"turndown": "^7.2.0",
		"unpdf": "^1.4.0"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "0.84.4",
		"@earendil-works/pi-coding-agent": "0.84.4",
		"@earendil-works/pi-tui": "0.84.4",
		"@types/node": "26.1.2",
		"@types/turndown": "5.0.6",
		"ignore": "7.0.5",
		"typebox": "1.3.11",
		"typescript": "7.0.2",
		"vitest": "4.1.10"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "pnpm test:core && pnpm test:features && pnpm test:analysis && pnpm test:telemetry-usage && pnpm test:cache-effort && pnpm test:profiles && pnpm test:clear && pnpm test:config-skill && pnpm test:provider-codex && pnpm test:provider-ollama && pnpm test:subscription-usage && pnpm test:safety && pnpm test:ask-user && pnpm test:advisor && pnpm test:subagents && pnpm test:todos && pnpm test:web-fetch && pnpm test:github-repo-skill && pnpm test:status && pnpm test:steer && pnpm test:goal && pnpm test:plan && pnpm test:worktree && pnpm test:workflows && pnpm test:integrations",
		"test:core": "pnpm test:shared && pnpm test:system-prompt",
		"test:shared": "vitest run extensions/_shared",
		"test:system-prompt": "vitest run extensions/config-system-prompt",
		"test:analysis": "vitest run extensions/telemetry-analysis",
		"test:telemetry-usage": "vitest run extensions/telemetry-usage",
		"test:cache-effort": "vitest run extensions/telemetry-cache-effort",
		"test:safety": "vitest run extensions/policy-permissions",
		"test:ask-user": "vitest run extensions/tools-ask-user",
		"test:advisor": "vitest run extensions/tools-advisor",
		"test:subagents": "vitest run extensions/tools-subagents",
		"test:subscription-usage": "vitest run extensions/provider-usage",
		"test:features": "vitest run extensions/config-feature-flag/catalog.test.ts extensions/config-feature-flag/index.test.ts extensions/ui-model-selector/index.test.ts extensions/ui-model-selector/model-selection-lifecycle.test.ts extensions/ui-context/context-model.test.ts extensions/ui-context/index.test.ts extensions/ui-context/usage-tables.test.ts",
		"test:profiles": "vitest run extensions/config-profiles",
		"test:clear": "vitest run extensions/ui-clear",
		"test:config-skill": "vitest run extensions/config-skill/index.test.ts extensions/config-skill/state.test.ts extensions/config-skill/diff.test.ts extensions/config-skill/git.test.ts",
		"test:provider-codex": "vitest run extensions/provider-codex",
		"test:provider-ollama": "vitest run extensions/provider-ollama",
		"test:todos": "vitest run extensions/tools-todo",
		"test:web-fetch": "vitest run extensions/tools-web-fetch extensions/tools-web-search",
		"test:github-repo-skill": "node --test skills/github-repo-explorer/scripts/github-repo-snapshot.test.mjs",
		"test:worktree": "vitest run extensions/tools-worktree",
		"test:goal": "vitest run extensions/workflows-goal",
		"test:plan": "vitest run extensions/workflows-plan",
		"test:workflows": "pnpm exec vitest run extensions/workflows-engine/index.test.ts extensions/workflows-engine/lib/worktree-artifacts.test.ts && node --test extensions/workflows-engine/tests/*.test.mjs",
		"test:integrations": "vitest run extensions-disabled/integration-plane/lib/plane/client.test.ts",
		"test:status": "vitest run extensions/ui-footer",
		"test:steer": "vitest run extensions/ui-steer-input"
	}
}
